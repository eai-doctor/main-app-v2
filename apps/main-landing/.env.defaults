# ---- Dev ----
# Auth-service the /api/auth proxy forwards to. Default = the local auth-service the other apps use in dev.
# To use the deployed one instead: https://auth-service-338917524320.northamerica-northeast1.run.app
EAI_AUTH_PROXY_TARGET=http://localhost:7860

# ---- Where the landing page sends people (defaults = local dev ports) ----
EAI_CLINIC_PORTAL_URL=http://localhost:5170
EAI_PATIENT_PORTAL_URL=http://localhost:5171
EAI_GENETIC_URL=http://localhost:4200
EAI_NUTRITION_URL=http://localhost:5174

# Browser-side auth URL. Leave as /api/auth (dev proxy above; vercel.json rewrite in production).
EAI_AUTH_URL=/api/auth
