# Browser-visible configuration only. Do not put a Medplum client secret here.
VITE_AUTH_PROVIDER=medplum
VITE_MEDPLUM_BASE_URL=https://api.eai-medplum-staging.tech/
VITE_MEDPLUM_APP_URL=https://medplum.eai-medplum-staging.tech/
VITE_MEDPLUM_PROJECT_ID=e079a6d4-0440-4425-a474-c69591584e49

# Optional public ClientApplication ID. Leave empty for the Medplum password
# sign-in flow until a dedicated main-clinic client has been created.
VITE_MEDPLUM_CLIENT_ID=

# Local landing page used after sign-out.
VITE_LANDING_URL=http://localhost:5180
